{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Strata",
  "version": "0.0.1",
  "identifier": "app.strata.desktop",
  "build": {
    "frontendDist": "../../packages/ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ../.. --filter @strata/ui dev",
    "beforeBuildCommand": "pnpm --dir ../.. --filter @strata/ui build"
  },
  "app": {
    "windows": [
      {
        "title": "Strata",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "backgroundColor": "#0b0c0e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Node-based notes and projects",
    "copyright": "Strata contributors, AGPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0"
    }
  }
}
